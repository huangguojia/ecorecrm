# ECORECRM 精简版：whatsapp-plugin 已移除，communication 服务用最小健康桩占位，
# 保持 compose 栈形状（backend depends_on communication healthy）不变。
# 如需恢复 WA 插件，把 GoodJob_private/whatsapp-plugin 拷回并用原 Dockerfile。
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

USER node
EXPOSE 3100
CMD ["node", "-e", "require('http').createServer((q,s)=>{s.statusCode=200;s.setHeader('content-type','text/plain');s.end('ecorecrm-communication-stub')}).listen(3100)"]
